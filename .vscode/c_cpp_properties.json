{
    "configurations": [
        {
            "name": "tomk-x86-32bit",
            "compilerPath": "i686-elf-gcc.exe",
            "compilerArgs": [
                "-std=gnu99",
                "-ffreestanding",
                "-march=i386"
            ],
            "cStandard": "gnu99",
            "intelliSenseMode": "gcc-x86",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src/include",
                "${workspaceFolder}/src/disasm/include",
                "${workspaceFolder}/src/driver/include",
                "${workspaceFolder}/src/init/include",
                "${workspaceFolder}/src/kd/include",
                "${workspaceFolder}/src/ke/include",
                "${workspaceFolder}/src/libc/include",
                "${workspaceFolder}/src/mm/include",
                "${workspaceFolder}/src/video/include"
            ],
            "defines": [
                "LIBK"
            ]
        }
    ],
    "version": 4
}
