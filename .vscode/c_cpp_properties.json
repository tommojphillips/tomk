{
    "configurations": [
        {
            "name": "tomk-x86-32bit",
            "compilerPath": "i686-elf-gcc.exe",
            "compilerArgs": [
                "-std=gnu99",
                "-ffreestanding"
            ],
            "cStandard": "gnu99",
            "intelliSenseMode": "gcc-x86",
            "includePath": [
                "${workspaceFolder}/src/include",
                "${workspaceFolder}/src/*/include"
            ],
            "defines": [
                "LIBK"
            ]
        }
    ],
    
    "version": 4
}
